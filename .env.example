# Copy to .env.local for local development. In Vercel, set these under
# Project -> Settings -> Environment Variables.

# Required. The password visitors type to see the site.
SITE_PASSWORD=

# Optional. "sample" shows made-up data (for local previews only).
# Leave unset in Vercel so the site loads live data from Polymarket.
DATA_SOURCE=

# Optional. Defaults to the Blue Rings wallet.
POLYMARKET_WALLET=
